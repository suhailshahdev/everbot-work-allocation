{
  "name": "everbot-work-allocation",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-based robot work allocation system for EverBot Solutions",
  "type": "module",
  "bin": {
    "everbot": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts",
    "format:check": "prettier --check README.md package.json package-lock.json eslint.config.js tsconfig.json tsconfig.build.json src tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
